# IBKR Gateway/TWS connection
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=27
IBKR_ACCOUNT=DUXXXXXXXX
IBKR_CURRENCY=EUR

# Safety: keep 0 until paper/live Gateway tests are complete.
IBKR_TRADING_LIVE=0
IBKR_ALLOW_SHORT=1

# Symbols to add to the scanner. Existing EURUSD/GBPUSD/USDJPY/AUDUSD/USDCAD
# are already present in the project universe.
IBKR_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD

# Contract definitions. Keep secrets OUT of Git.
# CASH examples:
# IBKR_CONTRACTS={"EURUSD":{"secType":"CASH","pair":"EURUSD","exchange":"IDEALPRO","currency":"USD","contract_size":1,"min_lot":1000,"lot_step":1000},"GBPUSD":{"secType":"CASH","pair":"GBPUSD","exchange":"IDEALPRO","currency":"USD","contract_size":1,"min_lot":1000,"lot_step":1000}}
# STK example:
# IBKR_SYMBOLS=AAPL,MSFT,SPY,QQQ,NVDA
# IBKR_CONTRACTS={"AAPL":{"secType":"STK","symbol":"AAPL","exchange":"SMART","currency":"USD","min_lot":0.001,"lot_step":0.001,"contract_size":1}}
