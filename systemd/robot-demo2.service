# Simulation "avant de deposer" -- 500 EUR virtuels, vraies cotations
# Bitvavo en direct, AUCUN ordre reel envoye. Voir run_demo.py.
#
# A installer avec : sudo cp systemd/robot-demo.service /etc/systemd/system/
#                     sudo systemctl daemon-reload
#                     sudo systemctl enable --now robot-demo
#
# Meme patron que robot-dual-live.service, sans risque financier -- le
# broker "paper" ne touche jamais l'API d'ordres de Bitvavo (lecture de
# prix uniquement, publique, sans cle).

[Unit]
Description=Simulation DEMO 2 -- 2e methode en parallele, capital virtuel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Eve-AI-Influencer
EnvironmentFile=/home/ubuntu/Eve-AI-Influencer/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/Eve-AI-Influencer/.venv/bin/python /home/ubuntu/Eve-AI-Influencer/run_demo.py --config robot.demo2.json --compte demo2
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-demo2

[Install]
WantedBy=multi-user.target

