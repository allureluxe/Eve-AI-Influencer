[Unit]
Description=Alluxe MCP server (stdio bridge for OpenAI Secure MCP Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alluxe
Group=alluxe
WorkingDirectory=/opt/Eve-AI-Influencer
EnvironmentFile=/etc/alluxe/mcp.env
ExecStart=/usr/bin/python3 /opt/Eve-AI-Influencer/ops/mcp_alluxe.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Eve-AI-Influencer
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
