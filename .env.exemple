
# ---------------------------------------------------------------------
#  IMPRESSION DES RAPPORTS (facultatif)
# ---------------------------------------------------------------------
#  Le robot tourne sur un serveur distant : il ne voit PAS une imprimante
#  branchée sur le wifi de la maison. La seule voie propre est
#  l'impression par courriel — l'imprimante a sa propre adresse chez le
#  fabricant, on lui envoie un PDF, elle l'imprime.
#
#    Epson  « Epson Email Print » (Epson Connect) — fonctionne
#    HP     « HP ePrint » — SERVICE FERMÉ depuis janvier 2023
#
#  Sans ces variables, tout marche comme avant : aucun message, aucune
#  erreur, simplement pas d'impression.
IMPRIMANTE_EMAIL=
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=587
SMTP_UTILISATEUR=
# Gmail : un « mot de passe d'application », PAS le mot de passe du
# compte. Se crée sur myaccount.google.com/apppasswords
SMTP_MOTDEPASSE=
