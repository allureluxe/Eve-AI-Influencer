# Service systemd du robot de trading Bitvavo spot.
# La configuration reste en simulation tant que BITVAVO_DRY_RUN=1.

[Unit]
Description=Robot de trading autonome Bitvavo
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Eve-AI-Influencer
EnvironmentFile=/home/ubuntu/Eve-AI-Influencer/.env
ExecStart=/usr/bin/python3 /home/ubuntu/Eve-AI-Influencer/run_bitvavo.py

Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gold-bot

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/ubuntu/Eve-AI-Influencer/data

[Install]
WantedBy=multi-user.target
