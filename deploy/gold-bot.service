# Service systemd du robot de trading Pionex Futures.
#
# Le lanceur run_pionex.py force le mode REEL et refuse toute bascule
# silencieuse vers la simulation.

[Unit]
Description=Robot de trading autonome Pionex Futures
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/opt/gold-bot
EnvironmentFile=/opt/gold-bot/.env
ExecStart=/usr/bin/python3 /opt/gold-bot/run_pionex.py

Restart=always
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=10

KillSignal=SIGTERM
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gold-bot

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gold-bot/data

[Install]
WantedBy=multi-user.target
