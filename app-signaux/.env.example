# Les clés PUBLIQUES seulement. Elles partent dans l'application, donc
# tout le monde peut les lire — c'est prévu, la RLS fait le travail.
#
# LA CLÉ service_role NE DOIT JAMAIS FIGURER ICI. Elle contourne la RLS :
# dans une application mobile, elle donne à n'importe qui la base entière.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
REVENUECAT_ANDROID_KEY=goog_...
EAS_PROJECT_ID=

# Ton code d'affiliation Bitvavo. Sans lui, le bouton « ouvrir un compte »
# renvoie vers bitvavo.com sans parrainage — donc sans commission et sans
# remise possible pour l'utilisateur.
BITVAVO_PARRAINAGE=
