{
  "expo": {
    "name": "Allure",
    "slug": "allure-trading",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "allure",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/logo-allure.png",
    "splash": {
      "image": "./assets/logo-allure.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "fr.allure.trading",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-allure.png",
        "backgroundColor": "#EFE73C"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "supabaseUrl": "@SUPABASE_URL",
      "supabaseAnonKey": "@SUPABASE_ANON_KEY",
      "revenueCatAndroidKey": "@REVENUECAT_ANDROID_KEY",
      "eas": {
        "projectId": "@EAS_PROJECT_ID"
      },
      "bitvavoParrainage": "@BITVAVO_PARRAINAGE"
    }
  }
}
