# Instagram
INSTAGRAM_USERNAME=your_instagram_email
INSTAGRAM_PASSWORD=your_instagram_password

# TikTok
TIKTOK_USERNAME=your_tiktok_email
TIKTOK_PASSWORD=your_tiktok_password

# AI Image Generation
STABILITY_API_KEY=your_stability_api_key

# OpenAI for captions
OPENAI_API_KEY=your_openai_api_key

# Schedule
POST_FREQUENCY=2  # posts per day

# ==========================================================================
#  ROBOT DE TRADING
# ==========================================================================

# --- Exécution MoonX (mode API REST) ---
MOONX_API_URL=https://api.moon-x.io
MOONX_API_KEY=votre_cle_moonx
MOONX_API_SECRET=
MOONX_ACCOUNT_ID=
MOONX_LEVERAGE=20
# Routes surchargeables si l'API diffère de la convention par défaut
# MOONX_ORDER_PATH=/api/v1/order
# MOONX_POSITIONS_PATH=/api/v1/positions
# MOONX_ACCOUNT_PATH=/api/v1/account
# Correspondance des symboles, si MoonX les nomme autrement
# MOONX_SYMBOL_XAUUSD=GOLD
# Formate et journalise les ordres sans les envoyer
# MOONX_DRY_RUN=1

# --- Exécution MoonX (mode pont : file d'attente consommée par un exécuteur) ---
# MOONX_BRIDGE_FILE=data/ordres_moonx.jsonl

# --- Sources de prix (toutes optionnelles : Yahoo et Binance marchent sans clé) ---
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
METALPRICE_API_KEY=

# --- Macro et calendrier économique ---
FRED_API_KEY=
FMP_API_KEY=
TRADINGECONOMICS_API_KEY=

# --- Alertes ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GB_WEBHOOK_URL=
GB_ALERT_EMAIL=

# --- Fichiers de travail ---
GB_STATE_FILE=data/state.json
GB_TRADES_FILE=data/trades.jsonl
GB_JOURNAL_FILE=data/journal.jsonl
GB_OBJECTIVE_FILE=data/objectives.json
GB_CALENDAR_FILE=data/economic_calendar.json

