# ==========================================================================
#  LUNA — compagne virtuelle IA (messages, appel, visio)
# ==========================================================================

# --- Moteur de conversation (le premier configure gagne) ---
# 1. Endpoint compatible OpenAI : le tien, une passerelle locale (Ollama,
#    llama.cpp, vLLM), ou un service specialise. C'est ici que se branche
#    un fournisseur de contenu adulte : sa politique de contenu s'applique.
LUNA_API_URL=
LUNA_API_KEY=
LUNA_API_MODELE=

# 2. Sinon, l'API Anthropic
ANTHROPIC_API_KEY=
LUNA_MODELE=claude-sonnet-5

# --- Images (visage coherent : l'ancre et la graine sont dans le code) ---
# STABILITY_API_KEY est reutilisee si elle est deja definie plus bas.
LUNA_IMAGE_URL=
LUNA_IMAGE_KEY=
LUNA_IMAGE_MODELE=stable-diffusion-v1-6

# --- Voix (optionnel : sans ca, c'est la synthese du navigateur) ---
LUNA_TTS_URL=
LUNA_TTS_KEY=
LUNA_TTS_VOIX=

# --- Avatar video temps reel (optionnel : sinon avatar vectoriel local) ---
LUNA_AVATAR_URL=
LUNA_AVATAR_KEY=
LUNA_AVATAR_ID=

# --- Application ---
LUNA_PORT=8765
LUNA_DONNEES=data/luna
# Obligatoire pour exposer l'app hors de 127.0.0.1. Sans lui, elle refuse
# de demarrer sur une autre adresse.
LUNA_TOKEN=

# Instagram
INSTAGRAM_USERNAME=your_instagram_email
INSTAGRAM_PASSWORD=your_instagram_password

# TikTok
TIKTOK_USERNAME=your_tiktok_email
TIKTOK_PASSWORD=your_tiktok_password

# AI Image Generation
STABILITY_API_KEY=your_stability_api_key
OPENAI_API_KEY=your_openai_api_key
POST_FREQUENCY=2

# ============================================================================
# ROBOT DE TRADING — BITVAVO UNIQUEMENT
# ============================================================================
# Cree une cle API Bitvavo avec View + Trade.
# NE PAS activer Withdraw. Restreindre la cle a l'IP du serveur si possible.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
BITVAVO_QUOTE_ASSET=EUR

# 1 = simulation, 0 = ordres reels.
# Le fichier robot.bitvavo.json est la configuration de production.
BITVAVO_DRY_RUN=1
BITVAVO_OPERATOR_ID=1
BITVAVO_WINDOW=10000
BITVAVO_TIMEOUT=15

# Tarif taker de repli si Bitvavo ne retourne pas le tarif du compte.
BITVAVO_FEE_RATE=0.0025

# --- Sources de prix ---
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
METALPRICE_API_KEY=

# --- Macro et calendrier ---
FRED_API_KEY=
FMP_API_KEY=
TRADINGECONOMICS_API_KEY=

# --- Alertes ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GB_WEBHOOK_URL=
GB_ALERT_EMAIL=

# --- Fichiers de travail ---
GB_STATE_FILE=data/state.json
GB_TRADES_FILE=data/trades.jsonl
GB_JOURNAL_FILE=data/journal.jsonl
GB_OBJECTIVE_FILE=data/objectives.json
GB_CALENDAR_FILE=data/economic_calendar.json

# --- Surcharges de configuration ---
# GB_RISK_BASE_RISK_PCT=0.5
# GB_RISK_MAX_POSITIONS=1
# GB_STRATEGY_MIN_SCORE=0.65
# GB_OBJECTIVES_BASE_TARGET=100

# Configuration Bitvavo utilisee par le raccourci de lancement.
GB_CONFIG=robot.bitvavo.json
