# ==========================================================================
#  LUNA — compagne virtuelle IA (messages, appel, visio)
# ==========================================================================

# --- Moteur de conversation (le premier configure gagne) ---
# 1. Endpoint compatible OpenAI : le tien, une passerelle locale (Ollama,
#    llama.cpp, vLLM), ou un service specialise. C'est ici que se branche
#    un fournisseur de contenu adulte : sa politique de contenu s'applique.
LUNA_API_URL=
LUNA_API_KEY=
LUNA_API_MODELE=

# 2. Sinon, l'API Anthropic
ANTHROPIC_API_KEY=
LUNA_MODELE=claude-sonnet-5

# --- Images (visage coherent : l'ancre et la graine sont dans le code) ---
# STABILITY_API_KEY est reutilisee si elle est deja definie plus bas.
LUNA_IMAGE_URL=
LUNA_IMAGE_KEY=
LUNA_IMAGE_MODELE=stable-diffusion-v1-6

# --- Voix (optionnel : sans ca, c'est la synthese du navigateur) ---
LUNA_TTS_URL=
LUNA_TTS_KEY=
LUNA_TTS_VOIX=

# --- Avatar video temps reel (optionnel : sinon avatar vectoriel local) ---
LUNA_AVATAR_URL=
LUNA_AVATAR_KEY=
LUNA_AVATAR_ID=

# --- Application ---
LUNA_PORT=8765
LUNA_DONNEES=data/luna
# Obligatoire pour exposer l'app hors de 127.0.0.1. Sans lui, elle refuse
# de demarrer sur une autre adresse.
LUNA_TOKEN=

# Instagram
INSTAGRAM_USERNAME=your_instagram_email
INSTAGRAM_PASSWORD=your_instagram_password

# TikTok
TIKTOK_USERNAME=your_tiktok_email
TIKTOK_PASSWORD=your_tiktok_password

# AI Image Generation
STABILITY_API_KEY=your_stability_api_key

# OpenAI for captions
OPENAI_API_KEY=your_openai_api_key

# Schedule
POST_FREQUENCY=2  # posts per day

# ==========================================================================
#  ROBOT DE TRADING
# ==========================================================================

# --- Exécution MoonX (mode API REST) ---
MOONX_API_URL=https://api.moon-x.io
MOONX_API_KEY=votre_cle_moonx
MOONX_API_SECRET=
MOONX_ACCOUNT_ID=
MOONX_LEVERAGE=20
# Routes surchargeables si l'API diffère de la convention par défaut
# MOONX_ORDER_PATH=/api/v1/order
# MOONX_POSITIONS_PATH=/api/v1/positions
# MOONX_ACCOUNT_PATH=/api/v1/account
# Correspondance des symboles, si MoonX les nomme autrement
# MOONX_SYMBOL_XAUUSD=GOLD
# Formate et journalise les ordres sans les envoyer
# MOONX_DRY_RUN=1

# --- Exécution MoonX (mode pont : file d'attente consommée par un exécuteur) ---
# MOONX_BRIDGE_FILE=data/ordres_moonx.jsonl

# --- Sources de prix (toutes optionnelles : Yahoo et Binance marchent sans clé) ---
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
METALPRICE_API_KEY=

# --- Macro et calendrier économique ---
FRED_API_KEY=
FMP_API_KEY=
TRADINGECONOMICS_API_KEY=

# --- Alertes ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GB_WEBHOOK_URL=
GB_ALERT_EMAIL=

# --- Fichiers de travail ---
GB_STATE_FILE=data/state.json
GB_TRADES_FILE=data/trades.jsonl
GB_JOURNAL_FILE=data/journal.jsonl
GB_OBJECTIVE_FILE=data/objectives.json
GB_CALENDAR_FILE=data/economic_calendar.json

# --- Surcharges de configuration (GB_<SECTION>_<PARAMETRE>) ---
# GB_RISK_BASE_RISK_PCT=0.5
# GB_RISK_MAX_POSITIONS=1
# GB_STRATEGY_MIN_SCORE=0.65
# GB_OBJECTIVES_BASE_TARGET=100

# --- Exécution Binance Futures (recommandé) ---
# Créer les clés sur Binance : Profil > Gestion API > Créer une API.
# Cocher UNIQUEMENT "Activer les Futures". Ne JAMAIS cocher les retraits.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 1 = testnet (argent fictif, testnet.binancefuture.com). Commencez par là.
BINANCE_TESTNET=1
# Le levier n'est pas un réglage de risque : il permet à la marge de tenir
# sur un petit compte. Le risque reste borné par le stop.
BINANCE_LEVERAGE=10
BINANCE_MARGIN_TYPE=ISOLATED
# Devise de cotation. USDT dans le monde, USDC pour les particuliers
# europeens (MiCA restreint l'USDT chez Binance dans l'UE).
BINANCE_QUOTE_ASSET=USDC
# BINANCE_DRY_RUN=1   # formate et journalise les ordres sans les envoyer

# ---------------------------------------------------------------------------
# BITVAVO — execution au comptant en euros, agree MiCA (AFM, Pays-Bas)
# ---------------------------------------------------------------------------
# La cle se cree dans l'espace client : Parametres > API.
#
# DROITS A COCHER : « Trade » (et « View », implicite).
# DROIT A NE JAMAIS COCHER : les retraits. Le robot n'en a aucun besoin, et
# une cle qui ne peut pas retirer de fonds ne peut pas vider le compte, meme
# si elle fuite.
#
# Restreindre la cle a l'adresse IP du serveur ferme la derniere porte.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Devise de cotation. Bitvavo est un marche europeen : l'euro evite toute
# conversion parasite entre le capital et les paires tradees.
BITVAVO_QUOTE_ASSET=EUR

# SECURITE : 1 = le robot analyse et journalise ses ordres SANS les envoyer.
# Le passage a 0 engage de l'argent reel. Ne le faire qu'apres avoir vu le
# robot tourner et decider correctement en simulation.
BITVAVO_DRY_RUN=1

# Identifiant numerique du robot qui passe l'ordre. Bitvavo l'exige au
# titre de la tracabilite MiCA : chaque ordre doit pouvoir etre rattache a
# l'operateur qui l'a emis. Sans lui, la plateforme repond
# « 400 [203] operatorId parameter is required ».
# BITVAVO_OPERATOR_ID=1

# Tarif taker de repli si /account/fees est illisible. Le robot lit d'abord
# le palier reel du compte : ne le forcer qu'en connaissance de cause.
# BITVAVO_FEE_RATE=0.0025

# ---------------------------------------------------------------------------
# OKX EUROPE — execution au comptant en euros, agree MiCA (MFSA, Malte)
# ---------------------------------------------------------------------------
# La cle se cree dans l'espace client : Profil > API.
#
# TROIS IDENTIFIANTS, PAS DEUX. OKX demande une PHRASE SECRETE que vous
# choisissez au moment de creer la cle. Elle n'est plus jamais reaffichee et
# ne peut pas etre retrouvee : notez-la tout de suite.
#
# DROITS A COCHER : « Trade » (et « Read », implicite).
# DROIT A NE JAMAIS COCHER : « Withdraw ». Le robot n'en a aucun besoin, et
# une cle qui ne peut pas retirer ne peut pas vider le compte, meme si elle
# fuite.
#
# Restreindre la cle a l'adresse IP du serveur ferme la derniere porte.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Devise de cotation. OKX Europe cote en EUR : pas de conversion parasite.
OKX_QUOTE_ASSET=EUR

# SECURITE : 1 = le robot analyse et journalise ses ordres SANS les envoyer.
# Le passage a 0 engage de l'argent reel.
OKX_DRY_RUN=1

# Compte de demonstration OKX (argent fictif, cles distinctes du reel).
# OKX_DEMO=1

# Domaine dedie aux clients de l'EEE, si OKX vous y redirige.
# OKX_API_URL=https://eea.okx.com

# ---------------------------------------------------------------------------
# DEUX ROBOTS EN PARALLELE
# ---------------------------------------------------------------------------
# Chaque robot ecrit son etat dans un fichier nomme d'apres sa plateforme
# (data/state-okx.json, data/state-bitvavo.json) : leurs plafonds de pertes
# et leurs journaux de trades restent separes, sans rien a configurer.
#
# Ces deux variables ne servent qu'a forcer un emplacement particulier.
# Les definir ici les imposerait AUX DEUX robots, qui se remettraient a
# s'ecraser mutuellement. Ne les activer qu'avec un fichier .env distinct
# par service.
# GB_STATE_FILE=
# GB_TRADES_FILE=

# Configuration retenue par les raccourcis (rempli par installer.sh)
GB_CONFIG=robot.binance.json
