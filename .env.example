# ============================================================================
#  Eve — configuration. Copier en `.env` puis remplir au fur et à mesure.
#  TOUT fonctionne sans aucune clé : les valeurs par défaut sont gratuites.
# ============================================================================

# --- sécurité d'exploitation ------------------------------------------------
DRY_RUN=1                    # 1 = rien n'est publié (à garder tant que tu testes)
REQUIRE_HUMAN_REVIEW=1       # 1 = tu valides chaque contenu avant publication
LOG_LEVEL=INFO

# --- génération d'images ----------------------------------------------------
# pollinations (gratuit, sans clé) | gemini (Google AI Studio, palier gratuit)
# comfyui (local, GPU) | stability | replicate | placeholder
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=flux
REEL_WIDTH=1080
REEL_HEIGHT=1920
PERSONA_SEED=774921          # ne pas changer : c'est le visage d'Eve

COMFYUI_URL=http://127.0.0.1:8188
# STABILITY_API_KEY=
# REPLICATE_API_TOKEN=

# --- voix off ---------------------------------------------------------------
VOICE_PROVIDER=edge-tts      # edge-tts (gratuit) | gemini | piper (local) | silent
VOICE_NAME=en-US-AvaNeural   # edge-tts en français : fr-FR-DeniseNeural
                             # gemini : Kore, Puck, Aoede, Charon…
VOICE_RATE=+8%

# --- rédaction (facultatif : sans clé, la bibliothèque locale suffit) --------
LLM_PROVIDER=template        # template | groq | gemini | ollama | anthropic
# GROQ_API_KEY=              # palier gratuit : console.groq.com
# GEMINI_API_KEY=            # palier gratuit : aistudio.google.com
                             # sert aussi aux images et à la voix
                             # (IMAGE_PROVIDER=gemini, VOICE_PROVIDER=gemini)
# ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# --- Instagram (API Graph officielle, compte Professionnel requis) ----------
# IG_USER_ID=
# IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0
# Instagram télécharge la vidéo depuis une URL publique (hébergement requis)
# PUBLIC_MEDIA_BASE_URL=https://exemple.com/eve

# --- TikTok (Content Posting API officielle) --------------------------------
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ACCESS_TOKEN=

# --- rythme de publication --------------------------------------------------
POSTS_PER_DAY=2
POST_SLOTS=06:30,18:00
TIMEZONE=America/New_York

# --- monétisation (à remplir quand les comptes existent) --------------------
# LINKINBIO_URL=https://beacons.ai/…
# SHOP_URL=
# STRIPE_PAYMENT_LINK=
# PAYPAL_ME=https://paypal.me/…
# AMAZON_ASSOCIATE_TAG=
# BUSINESS_EMAIL=contact@exemple.com
